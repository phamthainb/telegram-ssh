# Ignore version control
.git
.gitignore

# Ignore documentation and demo files
README.md
demo/
*.md

# Ignore dependency directories
node_modules/

# Ignore local development files
.vscode/
.DS_Store
.env
dev.sh

# Ignore test files
test.js

# Ignore build artifacts and logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore local data files
servers.json
keys/
data/

# Ignore docker files (to prevent recursion)
Dockerfile
docker-compose*.yml
.dockerignore